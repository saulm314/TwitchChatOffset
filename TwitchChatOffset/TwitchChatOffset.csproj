<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Version>3.3.0</Version>
    <Copyright>2025-2026 Saulius Markevicius</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="3.0.0"/>
    <PackageReference Include="System.IO.Hashing" Version="11.0.0"/>
    <PackageReference Include="CSVFile" Version="3.2.1"/>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\libs\YTSubConverter\YTSubConverter.Shared\YTSubConverter.Shared.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!-- Force rebuild if templates have been updated -->
    <CustomAdditionalCompileInputs Include="..\templates\**\*"/> <!-- MSBuild (and Visual Studio) -->
    <UpToDateCheckInput Include="..\templates\**\*"/> <!-- Visual Studio -->
  </ItemGroup>

  <Target Name="TcoPostBuild" AfterTargets="AfterBuild">
    <Message Importance="high" Text="[TCO:MSBuild] Running post-build..."/>
    <Exec Command="dotnet $(TargetPath) post-build" IgnoreStandardErrorWarningFormat="true"/>
    <Message Importance="high" Text="[TCO:MSBuild] post-build done."/>
  </Target>

</Project>
